{
  "version": "tools-1",
  "about": "Maps a PDF's producer, creator and XMP tool strings to a family and a kind. Ordered: the first pattern that matches wins, so specific patterns come before general ones. Patterns are case-insensitive regular expressions. The version is part of tier0's run signature; change it with the rules.",
  "kinds": {
    "ocr": "added a text layer by recognising a scanned image",
    "scanner": "a scanner or multifunction printer, or its capture software",
    "office": "an authoring application: word processor, spreadsheet, presentation, layout",
    "office_addin": "an authoring application's PDF export add-in",
    "reporting": "a report generator",
    "cad_gis": "an engineering drawing or mapping application",
    "printer_driver": "a virtual printer: the document was printed to PDF",
    "postscript": "converted through PostScript",
    "browser": "a web browser or its PDF engine",
    "pdf_editor": "a PDF application that edits, combines or re-saves",
    "pdf_library": "a programming library that writes PDFs",
    "esign": "an electronic signature service",
    "merger": "a tool that splits or combines PDFs",
    "generated": "an AI assistant",
    "unknown": "none of the above"
  },
  "rules": [
